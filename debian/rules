#!/usr/bin/make -f

export DH_COMPAT = 4

CONFIG	      = --enable-debug --enable-syslog --enable-proctitle \
		--enable-cache --enable-referrals --enable-ipv6 \
		--enable-local --with-cyrus-sasl --with-readline \
		--with-threads --enable-slapd --enable-cleartext \
		--enable-crypt --enable-passwd --enable-spasswd \
		--enable-multimaster --enable-phonetic --enable-rlookups \
		--enable-wrappers --enable-dynamic --enable-dnssrv \
		--enable-ldap --enable-ldbm --enable-shell --enable-sql \
		--enable-slurpd --enable-shared --enable-crypt-first \
		--prefix=/usr --localstatedir=/var/lib \
		--sysconfdir=/etc --libexecdir='$${prefix}'/sbin \
		--mandir='$${prefix}'/share/man --with-subdir=ldap \
		--with-tls


rootdir		:= $(shell pwd)
tmpdir		:= $(rootdir)/debian/tmp
builddir	:= $(rootdir)/debian/build

$(builddir)/Makefile:
	mkdir -p $(builddir)
	cd $(builddir) && CFLAGS=-D_FILE_OFFSET_BITS=64 $(rootdir)/configure \
		$(CONFIG) 
	perl debian/check_config
	$(MAKE) -C $(builddir) depend

build: $(builddir)/Makefile
	$(MAKE) -C $(builddir) DESTDIR=$(tmpdir) 

binary: binary-arch

binary-indep:

binary-arch: build
	dh_testdir
	dh_testroot
	dh_clean

	$(MAKE) -C $(builddir) DESTDIR=$(tmpdir) install
	sh debian/move_files

	dh_installchangelogs -a
	dh_installdocs -a
	dh_strip -a
	dh_compress -a
	dh_makeshlibs -a
	dh_shlibdeps -a
	dh_gencontrol -a
	dh_md5sums -a
	dh_builddeb -a

clean:
	dh_testdir
	dh_testroot
	rm -rf $(builddir) $(builddir_notls)
	dh_clean

.PHONY: binary binary-arch binary-indep build clean

