#!/usr/bin/make -f

export DH_COMPAT = 4

CONFIG	      = $(shell grep -v "^\#" debian/configure.options)

rootdir		:= $(shell pwd)
tmpdir		:= $(rootdir)/debian/tmp
builddir	:= $(rootdir)/debian/build

$(builddir)/Makefile:
	mkdir -p $(builddir)
	cd $(builddir) && CFLAGS=-D_FILE_OFFSET_BITS=64 $(rootdir)/configure \
		$(CONFIG) 
	perl debian/check_config
	$(MAKE) -C $(builddir) depend

build: $(builddir)/Makefile
	$(MAKE) -C $(builddir) DESTDIR=$(tmpdir) 

binary: binary-arch binary-indep

binary-indep:
	dh_testdir
	dh_testroot
	dh_clean -k

	dh_installdirs -i
	sh debian/copy_slapd_dev_files
	dh_installchangelogs -i
	dh_installdocs -i
	dh_installdebconf -i
	dh_installdeb -i
	dh_gencontrol -i
	dh_md5sums -i
	dh_builddeb -i

binary-arch: build
	dh_testdir
	dh_testroot
	dh_clean -k

	dh_installdirs -a
	$(MAKE) -C $(builddir) DESTDIR=$(tmpdir) install
	# Upstream installs schema files in mode 0444 - policy wants 0644
	find $(tmpdir)/etc -type f|xargs chmod 0644
	sh debian/move_files

	dh_installchangelogs -a
	dh_installdocs -a
	dh_installexamples -a
	dh_installinit -Xslapd.prerm -a -- "defaults 19 80"
	dh_installdebconf -a
	dh_strip -a
	dh_compress -a
	dh_makeshlibs libldap2
	dh_installdeb -a
	dh_shlibdeps -a
	dh_gencontrol -a
	dh_md5sums -a
	dh_builddeb -a

clean:
	dh_testdir
	dh_testroot
	rm -rf $(builddir) $(builddir_notls)
	dh_clean

.PHONY: binary binary-arch binary-indep build clean

