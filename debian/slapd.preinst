#! /bin/sh

set -e

# Make the version we are upgrading from globally available
oldver="$2"

# Parsing of slapd.conf
# Yes, I know, this is quite a hack but I don't know a better way 
# to pack this into a preinst script. We use perl to concat physical
# lines into logical lines and match them against a given regular expression
# to extract the interesting data, like in 
#	parse_slapd_conf 'suffix "(.*)"'
parse_slapd_conf() {
  (cat <<'EOF' && echo '^'$1'\s*$')|perl - /etc/ldap/slapd.conf
    local $/;
    @lines = split /\n(?!\s)/, <>;
    chop($pattern = <DATA>);
    $hits = 0;
    foreach $line (@lines) {
	  $line =~ s/\s+/ /g;
	  if ($line =~ /$pattern/) {
	  	print $1;
		$hits++;
	  }
    }
    exit 1 if $hits != 1;
    __DATA__
EOF
}

# Packages until at least 2.0.27-4 did not stop the daemon on upgrade so
# we do that before installation

if dpkg --compare-versions "$2" lt-nl 2.1; then
  if [ -x "/etc/init.d/slapd" ]; then
    if [ -x /usr/sbin/invoke-rc.d ] ; then
      invoke-rc.d slapd stop || true
    else
      /etc/init.d/slapd stop || true
    fi
  fi
fi

#DEBHELPER#
