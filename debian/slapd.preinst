#! /bin/sh

set -e

# Make the version we are upgrading from globally available
oldver="$2"

# Packages until at least 2.0.27-4 did not stop the daemon on upgrade so
# we do that before installation

# Make sure slapd is shut down before mucking with the db files
# and whatnot...  Use this function
stop_slapd() {
        # Source the init script configuration
        if [ -f "/etc/default/slapd" ]; then
                . /etc/default/slapd
        fi

        # Load the default location of the slapd config file
        if [ -z "$SLAPD_CONF" ]; then
                SLAPD_CONF="/etc/ldap/slapd.conf"
        fi

        # Find out the name of slapd's pid file
        if [ -z "$SLAPD_PIDFILE" -a -f "$SLAPD_CONF" ]; then
                SLAPD_PIDFILE=`sed -ne 's/^pidfile[[:space:]]\+\(.\+\)/\1/p' \
                        "$SLAPD_CONF"`
        fi

        # Use the pidfile if it is there, if not then just do without
        if [ -z "$SLAPD_PIDFILE" ]; then
                start-stop-daemon --stop --quiet --oknodo --retry 10 \
                        --exec /usr/sbin/slapd 2>&1
        else
                start-stop-daemon --stop --quiet --oknodo --retry 10 --pidfile \"$SLAPD_PIDFILE\" \
                        --exec /usr/sbin/slapd 2>&1
        fi
}

# If we are upgrading from an old version then
# stop slapd and attempt to slapcat out the data
# so we can use it in postinst to do the upgrade

if dpkg --compare-versions "$2" lt-nl 2.1; then
  if [ -x "/usr/sbin/slapcat" ]; then
    # Stop slapd
    stop_slapd

    # Make our backup directory if it does not
    # exist already
    if [ ! -d "/var/backups/ldap/$oldver/" ]; then
      mkdir -p /var/backups/ldap/$oldver/
    fi

    # Attempt to slapcat using old version
    SLAPCAT_FAIL=0
    slapcat > /var/backups/ldap/$oldver/slapd-${oldver}-slapcat.ldif || SLAPCAT_FAIL=1

    # Make note if the slapcat worked or not which will be
    # checked in postinst
    if [ "$SLAPCAT_FAIL" = "1" ]; then
      touch /var/backups/ldap/$oldver/slapd-${oldver}-slapcat.failed
    else
      touch /var/backups/ldap/$oldver/slapd-${oldver}-slapcat.success
    fi
  fi
fi

#DEBHELPER#
