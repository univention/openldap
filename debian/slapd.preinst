#! /bin/sh

set -e

# This will be replaced with debian/slapd.scripts-common which includes
# various helper functions and $OLD_VERSION and $SLAPD_CONF
#SCRIPTSCOMMON#

# Make sure slapd is shut down before mucking with the db files
# and whatnot...  Use this function
stop_slapd() {
  # Find out the name of slapd's pid file
  if [ -z "$SLAPD_PIDFILE" ] && [ -f "$SLAPD_CONF" ]; then
    SLAPD_PIDFILE=`read_slapd_conf < $SLAPD_CONF | sed -ne 's/^pidfile[[:space:]]\+\(.\+\)/\1/p'`
  fi

  # Use the pidfile if it is there, if not then just do without
  if [ -z "$SLAPD_PIDFILE" ]; then
    start-stop-daemon --stop --retry 10 --quiet --oknodo --exec /usr/sbin/slapd >/dev/null 2>&1
  else
    start-stop-daemon --stop --retry 10 --quiet --oknodo --pidfile "$SLAPD_PIDFILE" >/dev/null 2>&1
  fi
}

# If we are upgrading from an old version then stop slapd and attempt to
# slapcat out the data so we can use it in postinst to do the upgrade

# Packages until at least 2.0.27-4 did not stop the daemon on upgrade so
# we do that before installation

if database_might_need_reload && [ -x "/usr/sbin/slapcat" ]
then
  stop_slapd
  create_ldif_dump_location

  get_database_list | while read backend suffix directory
  do
    suffix=`eval echo $suffix`
    #echo "Processing directory $suffix..."
    location=`ldif_dump_location "$suffix"`

    if database_needs_reload "$backend" || database_needs_fixing; then
      echo -n "Dumping directory $suffix to $location with old slapcat... "
      slapcat -b "$suffix" > "$location" || SLAPCAT_FAIL=1
      if [ "$SLAPCAT_FAIL" = "1" ]; then
        echo "failed"
        rm -f "$location"
      else
        echo "done"
      fi
    fi

  done || exit $?
fi

#DEBHELPER#
