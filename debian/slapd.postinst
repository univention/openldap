#!/bin/sh

# Bail out on any error
set -e

# We need debconf
. /usr/share/debconf/confmodule

# Make the old version globally available
oldver="$2"

# Check, if the user wants an LDIF dump of the directory
# XXX: Currently dumps unconditionally
ldif_dump_wanted() { 
  return 0
}

# Ask for the filename of the dump file
# XXX: Currently just uses /var/backups/ldap/$oldver/slapd-${suffix}-slapcat.ldif
ldif_dump_location() {
  local suffix=$1
  echo "/var/backups/ldap/$oldver/slapd-${suffix}-slapcat.ldif"
}

# Make sure slapd is shut down before mucking with the db files
# and whatnot...  Use this function
stop_slapd() {
        create_sed_script
        # Find out the name of slapd's pid file
        if [ -z "$SLAPD_PIDFILE" -a -f "$SLAPD_CONF" ]; then
                SLAPD_PIDFILE=`sed -f $SEDSCRIPT < $SLAPD_CONF | \
                               sed -ne 's/^pidfile[[:space:]]\+\(.\+\)/\1/p'`
        fi

        # Use the pidfile if it is there, if not then just do without
        if [ -z "$SLAPD_PIDFILE" ]; then
                start-stop-daemon --stop --quiet --oknodo --retry 10 \
                        --exec /usr/sbin/slapd 2>&1
        else
                start-stop-daemon --stop --quiet --oknodo --retry 10 --pidfile \"$SLAPD_PIDFILE\" \
                        --exec /usr/sbin/slapd 2>&1
        fi
        if [ -e $SEDSCRIPT ]; then rm $SEDSCRIPT ; fi
}

create_sed_script() {
  SEDSCRIPT=`mktemp`
  if [ ! -f "$SEDSCRIPT" ]; then
    echo "Could not create temp file."
    exit 1
  fi
  cat <<EOF > $SEDSCRIPT
{
  s/^[#[:space:]][#[:space:]]*/&/
  t other
  b start
  :start
    N
    s/\n[       ][      ]*/ /
    t start
    b end
    p
  :other
    b end
  :end
}
EOF
}

# Get the list of configured databases from slapd.conf
get_database_list() {
  create_sed_script
  sed -f $SEDSCRIPT < $SLAPD_CONF | 
  grep -E '^(database|directory|suffix)' | \
  (
    while read type val
    do
      if [ "$type" = "database" ]
      then
        if [ -n "$backend" -a -n "$suffix" ]; then
          if [ "$backend" = "ldbm" -o "$backend" = "bdb" ] \
             && [ -z "$directory" ]
          then
            directory=/usr/share/ldap/openldap-data
          fi
          echo $backend \"$suffix\" \"$directory\"
        fi

        backend=$val
        suffix=""
        directory=""
      elif [ "$type" = "suffix" ]; then
        # Directory names are whitespace-sensitive, but suffixes
        # are not.  Discard whitespace, so we can create cleaner
        # backup directory names.
        suffix=`echo $val | sed -e's/[[:space:]]\+//g; s/^"//; s/"$//;'`
      elif [ "$type" = "directory" ]; then
        directory=`echo $val | sed -e's/^"//; s/"$//;'`
      fi
    done

    # Fall out of the loop, print the info for the last backend.
    if [ "$backend" = "ldbm" -o "$backend" = "bdb" ] && [ -z "$directory" ]
    then
      directory=/usr/share/ldap/openldap-data
    fi
    echo $backend \"$suffix\" \"$directory\"
  )   
  if [ -e $SEDSCRIPT ]; then rm $SEDSCRIPT; fi
}

# Source the init script configuration
if [ -f "/etc/default/slapd" ]; then
  . /etc/default/slapd
fi

# Load the default location of the slapd config file
if [ -z "$SLAPD_CONF" ]; then
  SLAPD_CONF="/etc/ldap/slapd.conf"
fi

# Only create a new directory on a fresh install or on reconfigure
if [ "$1" = configure -a -z "$2" ] || [ "$1" = reconfigure ] \
        || [ "$DEBCONF_RECONFIGURE" ]; then
  db_get slapd/domain
  basedn="dc=`echo $RET|sed 's/\./,dc=/g'`"
  dc="`echo $RET|sed 's/\..*$//'`"
  db_get shared/organization
  organization="$RET"
  db_get slapd/internal/adminpw
  adminpass="$RET"

  # Make sure the daemon is shut down
  stop_slapd

  TMPFILE=`mktemp -q ${SLAPD_CONF}.XXXXXX`
  if [ ! -e $SLAPD_CONF ]; then
    echo -n "Creating initial slapd configuration... "
    sed -e "s/@SUFFIX@/$basedn/g" -e "s/@ADMIN@/cn=admin,$basedn/g" \
        </usr/share/slapd/slapd.conf >$TMPFILE
  else
    echo -n "Updating slapd configuration... "
    create_sed_script
    OLDSUFFIX=`sed -f $SEDSCRIPT < $SLAPD_CONF | \
               sed -n 's/^suffix[[:space:]]\+"\(.*\)"/\1/p' \
               | head -1`
    if [ "$OLDSUFFIX" != "$basedn" ]; then
      db_fset slapd/suffix_change seen false
      db_set slapd/suffix_change false
      db_input high slapd/suffix_change || true
      db_go || true

      db_get slapd/suffix_change || false

      if [ "$RET" = "true" ]; then

        chmod --reference=$SLAPD_CONF $TMPFILE
        sed -f $SEDSCRIPT < $SLAPD_CONF | \
            sed -e"/^suffix[[:space:]]\+$OLDSUFFIX/ s/$OLDSUFFIX/$basedn/" \
                -e"s/cn=admin,$OLDSUFFIX/cn=admin,$basedn/g" \
                > $TMPFILE

        # Back up the old database before trying to run slapadd.
        if [ ! -e /var/backups/slapd-$OLDSUFFIX ]; then
          mkdir -p /var/backups/slapd-$OLDSUFFIX
        fi
        if [ ! -f /var/lib/slapd/suffix_change ]; then
          mv /var/lib/ldap/* /var/backups/slapd-$OLDSUFFIX
        fi
      else
        # If we aren't updating, we don't want to overwrite with an
        # empty config!
        rm $TMPFILE
      fi
    fi
    if [ -e $SEDSCRIPT ]; then rm $SEDSCRIPT ; fi
  fi
  [ -f $TMPFILE ] && mv $TMPFILE $SLAPD_CONF
  echo "done"

  echo -n "Creating initial LDAP directory... "
  touch /var/lib/slapd/suffix_change

  cat <<EOF|slapadd
dn: $basedn
objectClass: top
objectClass: dcObject
objectClass: organization
o: $organization
dc: $dc

dn: cn=admin,$basedn
objectClass: simpleSecurityObject
objectClass: organizationalRole
cn: admin
description: LDAP administrator
userPassword: $adminpass

EOF

  echo "done"
fi

# Check for adding ldap_v2 support
# This could probably be reused to add other things
# to the allow line if we want in the future...
db_get slapd/allow_ldap_v2
if [ "$RET" = "true" ]; then

  create_sed_script

  # Check if it is there already
  TEST=`sed -f $SEDSCRIPT < $SLAPD_CONF | grep -E "^allow[[:space:]][^#]*bind_v2"`
  if [ -z "$TEST" ]; then
    echo -n "Adding 'allow bind_v2' to slapd config..."
    
    TMPFILE=`mktemp -q $SLAPD_CONF.XXXXXX`
    chmod --reference=$SLAPD_CONF $TMPFILE
    
    # Check if there is an allow line there already
    ALLOWC=`sed -f $SEDSCRIPT < $SLAPD_CONF | grep -E "^[#[:space:]]*allow"`
    if [ -z "$ALLOWC" ]; then
      # No allow line there, add one
      echo "# Allow LDAPv2 binds" > $TMPFILE
      echo "allow bind_v2" >> $TMPFILE
      cat $SLAPD_CONF >> $TMPFILE
    else
      # Allow line exists already
      # Check if it is real or commented out
      ALLOW=`grep -E "^allow[[:space:]]" $SLAPD_CONF `
      if [ ! -z "$ALLOW" ]; then
        # It's real, hack it up...
        COMMENT=`echo $ALLOWC | cut -f2- -d'#'`
        OPTIONS=`echo $ALLOWC | sed -e 's:^allow[[:space:]]*::' -e 's:\#.*::'`
        sed -f $SEDSCRIPT < $SLAPD_CONF | sed -e "s:$ALLOWC:allow bind_v2 $OPTIONS # $COMMENT:" > $TMPFILE
      else
        # Must be commented out, uncomment and add our option
        OPTIONS=`echo $ALLOWC | sed -e 's:^[#[:space:]]*allow[[:space:]]*::'`
        sed -f $SEDSCRIPT < $SLAPD_CONF | sed -e "s:$ALLOWC:allow bind_v2 # $OPTIONS:" > $TMPFILE
      fi
    fi
    if [ -s "$TMPFILE" ]; then
      mv $TMPFILE $SLAPD_CONF
      echo done
    else
      rm $TMPFILE
      echo
      echo "Failed to add LDAP V2 allow, original slapd.conf untouched."
      read
    fi
  fi
  if [ -e $SEDSCRIPT ]; then rm $SEDSCRIPT ; fi
fi

# On upgrades from pre-2.1 we might have to update the configuration 
# file for loading the backend modules.
if dpkg --compare-versions "$2" lt-nl 2.1 \
   && ! grep -q modulepath $SLAPD_CONF
then
  db_get slapd/autoconf_modules || true
  if [ "$RET" = "true" ]; then
    create_sed_script
    echo -n "Updating config for dynamic backends... "
    TMPFILE=`mktemp -q ${SLAPD_CONF}.XXXXXX`
    chmod --reference=$SLAPD_CONF $TMPFILE
    cat <<EOF >$TMPFILE
# Loading of backend modules - automatically generated

modulepath      /usr/lib/ldap
EOF
    sed -f $SEDSCRIPT < $SLAPD_CONF | \
        sed -n 's/^database[[:space:]]\+\([a-z]\+\)/moduleload      back_\1/p' \
              >>$TMPFILE
    echo >>$TMPFILE
    cat $SLAPD_CONF >>$TMPFILE
    mv $TMPFILE $SLAPD_CONF
    echo done
    if [ -e $SEDSCRIPT ]; then rm $SEDSCRIPT ; fi
  fi
fi

# Move the old database files out of the way
# XXX: User interaction - target directory
if dpkg --compare-versions "$oldver" lt-nl 2.1 && ldif_dump_wanted; then
  stop_slapd

  db_get shared/organization
  organization="$RET"

  mkdir -p /var/backups/ldap/$oldver/
fi

if dpkg --compare-versions "$oldver" lt-nl 2.1; then
  get_database_list | while read backend suffix directory
  do
    # parse out the quotes; we no longer need them for grouping
    suffix=`eval echo $suffix`
    directory=`eval echo $directory`

    location=`ldif_dump_location $suffix`

    if [ ! -f "/var/lib/slapd/upgrade_2.0-$suffix" ]
    then
      if ldif_dump_wanted; then

        # XXX: to be truly idempotent, we should make sure we don't try to
        # overwrite this ldif file on a second pass after already having
        # moved some of the files aside below.

        # Check if the preinst slapcat worked or not, if not, go ahead and
        # attempt to slapcat here with the new version of slapcat
        SLAPCAT_FAIL=0
        if [ ! -e "$location" ]; then
          echo -n "Dumping directory to $location with new slapcat... "
          slapcat -b "$suffix" > "$location" || SLAPCAT_FAIL=1
          if [ "$SLAPCAT_FAIL" = "1" ]; then
            echo "failed"
            rm -f "$location"
            # XXX: now that we handle multiple dbs, this note should
            # mention the suffix of the failed database.
            db_input slapd/upgrade_slapcat_failure
          else
            echo "done"
          fi
        fi

        # Fix the directory when upgrading from before 2.1 and the root
        # dn has no structural objectclass

        # We should now have a valid ldif file, created either in the
        # preinst or above.  If we don't, then the user has been
        # notified and just give up.
        if [ -e "$location" ]; then
          /usr/share/slapd/fix_ldif -w -o "$organization" < "$location" > "${location}.fixed"
        fi
      fi

      # We may not have a directory at all for some backends -- if so,
      # skip this part; it won't work.
      if [ -n "$directory" ]; then
        echo -n "Moving old database files to /var/backups/ldap/$oldver/... "
        mkdir -p "/var/backups/ldap/$oldver/$suffix"
        mv "$directory"/* "/var/backups/ldap/$oldver/$suffix/"
      fi
      touch "/var/lib/slapd/upgrade_2.0-$suffix"
      echo done
    fi

    # If a dump file from the old version exists we want to recreate the
    # directory from it
    if [ -e "${location}.fixed" ]; then
      echo -n "Recreating directory from ${location}.fixed... "
      SLAPADD_FAIL=0
      slapadd -b "$suffix" -u -l "${location}.fixed" || SLAPADD_FAIL=1
      if [ "$SLAPADD_FAIL" = "1" ]; then
        echo "failed"
        db_input slapd/upgrade_slapadd_failure
        exit 1
      else
        slapadd -b "$suffix" -l "${location}.fixed"
        echo "done"
      fi
    fi
  # Since this is actually a subshell, we need to explicitly
  # call exit: otherwise, the errors won't be caught, and the rm command
  # below gets run!
  done || exit $?
fi

db_stop

#DEBHELPER#

rm -f /var/lib/slapd/upgrade_2.0-* /var/lib/slapd/suffix_change
