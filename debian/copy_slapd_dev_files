#! /bin/sh

set -e

echo -n "Installing: "
target=libslapd2.2-dev
echo -n " $target"
find include -name "*.h" -print | sed -e 's:^include/::' |
while read line; do
  dir="`dirname $line`"
  name="`basename $line`"

  mkdir -p debian/libslapd2.2-dev/usr/include/slapd/$dir
  cp include/$dir/$name debian/libslapd2.2-dev/usr/include/slapd/$dir/
done
echo "."
