#! /bin/sh

set -e

# Load debconf
. /usr/share/debconf/confmodule

# Set up the defaults for our templates
set_defaults_for_unseen_entries() {
  DOMAIN=`hostname -d`
  if [ -z "$DOMAIN" ]; then DOMAIN='debian.org'; fi

  db_fget slapd/domain seen
  if [ "$RET" = false ]; then
    db_set slapd/domain "$DOMAIN"
  fi

  db_fget shared/organization seen
  if [ "$RET" = false ]; then
    db_set shared/organization "$DOMAIN"
  fi
}

# Grab the current database suffix, if any
if [ -e /etc/ldap/slapd.conf ]; then
  basedn=`sed -n 's/^suffix[[:space:]]\+"\(.*\)"/\1/p' < /etc/ldap/slapd.conf \
          | head -1`
  domain=`echo $basedn | sed -e's/dc=//g; s/,/./g'`
  db_set slapd/domain "$domain"
fi

# Create an initial directory on fresh install

if [ "$1" = configure -a -z "$2" ] || [ "$1" = reconfigure ] \
        || [ "$DEBCONF_RECONFIGURE" ]; then
  db_input low slapd/no_configuration || true
  db_go || true
  db_get slapd/no_configuration
  no_configuration="$RET"
  
  if [ "$no_configuration" = "true" ]; then
    exit 0
  fi
  
  set_defaults_for_unseen_entries
    
  # if domain or organization isn't valid, don't attempt to configure
  for var in slapd/domain shared/organization; do
    db_input medium $var || true
    db_go || true
    db_get $var
    value="$RET"
    
    while [ -z "$value" ]; do
      db_fset slapd/invalid_suffix seen false
      db_input high slapd/invalid_suffix true || true
      db_go || true
      db_get slapd/invalid_suffix
      no_configuration="$RET"
      
      if [ "$no_configuration" = "true" ]; then
        db_set slapd/no_configuration true
        exit 0
      else
        db_fset $var seen false
        db_input medium $var || true
        db_go || true
        db_get $var
        value="$RET"
      fi
    done
  done
   
  db_input critical slapd/password1 || true
  db_input critical slapd/password2 || true
  db_input low slapd/purge_database || true
  db_go || true

  # Make sure the passwords match
  db_get slapd/internal/adminpw
  if [ -z "$RET" ]; then
    db_get slapd/password1
    pass1="$RET"
    db_get slapd/password2
    pass2="$RET"
    
    while [ "$pass1" != "$pass2" ]; do
      db_fset slapd/password1 seen false
      db_fset slapd/password2 seen false
      db_input critical slapd/password1 || true
      db_input critical slapd/password2 || true
      db_go || true
      db_get slapd/password1
      pass1="$RET"
      db_get slapd/password2
      pass2="$RET"
    done
    
    # create password hash
    export pass1
    adminpw=`perl -e 'sub GenRandom {
      local ($len) = @_;
      local ($char, $data, @chars);
      @chars=split(//, "abcdefghijklmnopqrstuvwxyzaABCDEFGHIJKLMNOPQRSTUVWXYZA01234567890");
    
      open(RD, "</dev/urandom") or die "Failed to open random source";
      $data="";
      while ($len--) {
	die "Failed to read random data" if (read(RD, $char, 1)!=1);
	    $data.=$chars[ord($char)%($#chars+1)];
      }
    
      close(RD);
      return $data;
    }
    print crypt($ENV{pass1}, GenRandom(2));'`
    
    db_set slapd/password1 ""
    db_set slapd/password2 ""
    db_set slapd/internal/adminpw "{crypt}$adminpw"
  fi
fi

# On upgrade from pre-2.1 we have to ask if we shall fix the config file (if
# it exists anyway).
if dpkg --compare-versions "$2" lt-nl 2.1; then
  if [ -e /etc/ldap/slapd.conf ]; then
    db_input medium slapd/autoconf_modules || true
    db_go || true
  fi
fi

# Ask if the user would like their package to support LDAPv2..
# This was the default in older versions but we want to ask
# for new installs too in case the user needs it..
db_input medium slapd/allow_ldap_v2 || true
db_go || true
db_stop || true
